  "faqCameraNotSeeingQ": "Why can't the camera see my movements?",
  "@faqCameraNotSeeingQ": {
    "description": "FAQ question — camera framing"
  },
  "faqCameraNotSeeingA": "Analysis needs your whole body in frame. Put the phone on the floor or another stable spot about 2 metres away, hold it in portrait and make sure the room is well lit. If you see the \"Step into frame\" warning, move back a little.",
  "@faqCameraNotSeeingA": {
    "description": "FAQ answer — camera framing"
  },
  "faqPhoneSideQ": "Do I need to put the phone to the side for some exercises?",
  "@faqPhoneSideQ": {
    "description": "FAQ question — camera placement per exercise"
  },
  "faqPhoneSideA": "Yes. For exercises that need a side view — push-ups, planks, hip movements — place the phone to your side. Form reminds you out loud once on those exercises.",
  "@faqPhoneSideA": {
    "description": "FAQ answer — camera placement per exercise. 'Form' is the coach's name and stays untranslated."
  },
  "faqNoCameraQ": "Can I train without the camera?",
  "@faqNoCameraQ": {
    "description": "FAQ question — camera-free mode"
  },
  "faqNoCameraA": "Yes. You can complete a workout without the camera and count reps yourself. Form analysis only runs while the camera is on.",
  "@faqNoCameraA": {
    "description": "FAQ answer — camera-free mode"
  },
  "faqPhoneRingsQ": "What happens if my phone rings during a workout?",
  "@faqPhoneRingsQ": {
    "description": "FAQ question — interruption handling"
  },
  "faqPhoneRingsA": "The workout pauses automatically and the camera shuts down safely. When you come back you can carry on where you left off — nothing is lost.",
  "@faqPhoneRingsA": {
    "description": "FAQ answer — interruption handling"
  },
  "faqOfflineQ": "Can I train without an internet connection?",
  "@faqOfflineQ": {
    "description": "FAQ question — offline use"
  },
  "faqOfflineA": "Yes. Workouts and form analysis run entirely on your device. Completed days sync automatically once you are back online.",
  "@faqOfflineA": {
    "description": "FAQ answer — offline use"
  },
  "faqWhoIsFormQ": "Who is Form?",
  "@faqWhoIsFormQ": {
    "description": "FAQ question — the AI coach's identity. 'Form' is the coach's name, never translated."
  },
  "faqWhoIsFormA": "Form is FormAI's AI coach. Form knows your training history, your plan and your goal, and you can ask about anything. Tap the avatar at the top to open the chat.",
  "@faqWhoIsFormA": {
    "description": "FAQ answer — the AI coach's identity"
  },
  "faqShortAnswersQ": "Why does Form sometimes give a short answer?",
  "@faqShortAnswersQ": {
    "description": "FAQ question — coach answer length"
  },
  "faqShortAnswersA": "Form only says what it actually knows. Rather than guessing on something it has no data for, it gives a short, honest answer.",
  "@faqShortAnswersA": {
    "description": "FAQ answer — coach answer length"
  },
  "faqHealthAdviceQ": "Can Form give health advice?",
  "@faqHealthAdviceQ": {
    "description": "FAQ question — medical disclaimer"
  },
  "faqHealthAdviceA": "No. FormAI is a training and nutrition assistant, not a medical device. If you have a health problem, pain or a chronic condition, always consult a doctor.",
  "@faqHealthAdviceA": {
    "description": "FAQ answer — medical disclaimer. Store-compliance copy: the meaning must be preserved exactly in every locale."
  },
  "faqCancelSubQ": "How do I cancel my subscription?",
  "@faqCancelSubQ": {
    "description": "FAQ question — subscription cancellation"
  },
  "faqCancelSubA": "Go to Profile → Settings → \"Cancel subscription\". Cancellation completes through your Google Play account. After cancelling you keep Premium features until the end of the current period.",
  "@faqCancelSubA": {
    "description": "FAQ answer — subscription cancellation. Store-compliance copy; the navigation path must match the actual UI labels in each locale."
  },
  "faqTransferPurchaseQ": "How do I move my purchase to a new phone?",
  "@faqTransferPurchaseQ": {
    "description": "FAQ question — restoring purchases"
  },
  "faqTransferPurchaseA": "Sign in with the same Google account and tap \"Restore purchases\" on the payment screen. Your subscription belongs to your account, not to a device.",
  "@faqTransferPurchaseA": {
    "description": "FAQ answer — restoring purchases"
  },
  "faqFreeFeaturesQ": "What can I use without Premium?",
  "@faqFreeFeaturesQ": {
    "description": "FAQ question — free vs paid features"
  },
  "faqFreeFeaturesA": "The 30-day training programme, real-time form analysis, the AI coach, your calorie and macro targets and the recipe library are all free. Premium unlocks your personalised daily nutrition plan and meal tracking.",
  "@faqFreeFeaturesA": {
    "description": "FAQ answer — free vs paid features. Store-compliance copy: this must stay an accurate description of what money buys."
  },
  "faqDataStorageQ": "Where is my data stored?",
  "@faqDataStorageQ": {
    "description": "FAQ question — data storage and privacy"
  },
  "faqDataStorageA": "Camera footage never leaves your device — form analysis runs entirely on your phone and no image is ever recorded or sent. Your training progress and profile details are stored on secure servers, tied to your account.",
  "@faqDataStorageA": {
    "description": "FAQ answer — data storage and privacy. Privacy-policy-adjacent copy: the claims must remain literally true in every locale."
  },
  "faqDeleteAccountQ": "How do I delete my account?",
  "@faqDeleteAccountQ": {
    "description": "FAQ question — account deletion"
  },
  "faqDeleteAccountA": "Profile → Account settings → \"Delete account\". This is permanent: your training history, profile details and all your data are removed.",
  "@faqDeleteAccountA": {
    "description": "FAQ answer — account deletion"
  },
  "faqGuestProgressQ": "I'm using it as a guest — will I lose my progress?",
  "@faqGuestProgressQ": {
    "description": "FAQ question — guest progress"
  },
  "faqGuestProgressA": "Guest progress is kept only on this device. Create an account from the Profile screen to keep it — your existing progress moves across with you.",
  "@faqGuestProgressA": {
    "description": "FAQ answer — guest progress"
  },
  "faqNoRemindersQ": "I'm not getting reminder notifications.",
  "@faqNoRemindersQ": {
    "description": "FAQ question — notifications not arriving"
  },
  "faqNoRemindersA": "Make sure you have picked a time under Profile → Account settings → \"Notifications\". Also check that notification permission is granted for FormAI in your phone's settings, and that battery optimisation is not restricting the app.",
  "@faqNoRemindersA": {
    "description": "FAQ answer — notifications not arriving"
  },
  "faqStreakResetQ": "Why did my streak reset?",
  "@faqStreakResetQ": {
    "description": "FAQ question — streak rules"
  },
  "faqStreakResetA": "Your streak is counted in calendar days and allows one rest day. If you take more than two days off in a row, the streak starts again.",
  "@faqStreakResetA": {
    "description": "FAQ answer — streak rules"
  },
  "faqReportBugQ": "I found a bug — how do I report it?",
  "@faqReportBugQ": {
    "description": "FAQ question — reporting a bug"
  },
  "faqReportBugA": "Write to us directly through Profile → Settings → \"Support & feedback\". Every message is read and answered — your feedback shapes FormAI.",
