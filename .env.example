SUPABASE_URL=
SUPABASE_ANON_KEY=

REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=

# Phase 51 · CDN base URL for video + image media. Optional.
#   • When set, exercise videos and admin-uploaded recipe / exercise
#     images are served from `<CDN_BASE_URL>/<bucket>/<path>` instead
#     of the raw Supabase Storage public endpoint, cutting egress
#     bandwidth at scale.
#   • When empty (default), media URLs fall back to Supabase Storage
#     so a fresh checkout works without an external CDN configured.
# Example: CDN_BASE_URL=https://cdn.formai.app
CDN_BASE_URL=
