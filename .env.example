# FormAI — environment template.
#
# Copy to `.env` and fill with your project's CLIENT-PUBLIC values only.
# These keys are bundled into the app and are extractable from any mobile
# binary by design; they are safe to ship because access is enforced
# server-side (Supabase RLS, RevenueCat entitlements verified via webhook).
#
# NEVER add a true secret here or in `.env`:
#    SUPABASE_DB_PASSWORD, any *SERVICE_ROLE* key, *_SECRET, or a PRIVATE KEY.
#    Ops-only secrets belong in `.env.local` (gitignored, NOT a Flutter asset)
#    or in CI secrets. A build-time guard (tool/check_env_no_secrets.sh) and
#    gitleaks (.github/workflows/secret-scan.yml) enforce this.

SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client id from the Google Cloud console (the one inside
# GoogleService-Info.plist). Read by auth_provider on Platform.isIOS;
# without it iOS Google Sign-In fails at runtime.
GOOGLE_IOS_CLIENT_ID=

REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# Phase 51 · CDN base URL for video + image media. Optional.
#   • When set, exercise videos and admin-uploaded recipe / exercise
#     images are served from `<CDN_BASE_URL>/<bucket>/<path>` instead
#     of the raw Supabase Storage public endpoint, cutting egress
#     bandwidth at scale.
#   • When empty (default), media URLs fall back to Supabase Storage
#     so a fresh checkout works without an external CDN configured.
# Example: CDN_BASE_URL=https://cdn.formai.app
CDN_BASE_URL=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

# AI Coach · gates the real LLM coach. When 'true' AND the `coach-chat` Edge
# Function is deployed with an ANTHROPIC_API_KEY secret, the coach answers with
# a real Claude model; on any network/model failure it falls back to the
# offline rule-based coach automatically. Leave 'false' until the function is
# deployed (see FOUNDER_MASTER_GUIDE_APPENDIX.md A1). NOT a secret — this is
# only an on/off flag; the model key lives server-side, never in this file.
COACH_LLM_ENABLED=false
