# Environment variables (NEVER commit)
.env
.env.*
!.env.example

# Supabase CLI scratch directory — local-only state, not source.
supabase/.temp/

# GCP / service-account credentials (NEVER commit). Scoped patterns instead
# of a blanket *.json so legitimate files (web/manifest.json, iOS/macOS
# Contents.json, future google-services.json, i18n files, etc.) stay tracked.
formai-*.json
*-service-account*.json
service-account*.json
*-credentials.json

