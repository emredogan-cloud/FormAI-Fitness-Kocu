<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 55 · Runner entitlements.

  Same App Group ID as FormAIWidget.entitlements. Both targets must
  share this group for the home-widget data bridge and Live Activity
  payload bridge to work — the `home_widget` and `live_activities`
  packages key off the suite identifier exactly.

  In Xcode: select Runner target → Signing & Capabilities → "+
  Capability" → App Groups → check group.app.formai.shared.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.formai.shared</string>
    </array>
    <!-- Sign in with Apple (Apple 4.8): the auth screen offers
         third-party (Google) sign-in, so a functional Apple option is
         mandatory on iOS. The matching capability must also be enabled
         for the App ID in the Developer portal / Xcode Signing &
         Capabilities (REQUIRES APPLE ENVIRONMENT to validate). -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
</dict>
</plist>
