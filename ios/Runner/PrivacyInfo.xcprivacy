<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Phase 41 · Apple Privacy Manifest for SixPack AI (FormAI).

    Declares:
      · NSPrivacyTracking = false — we do NOT track users across
        third-party apps or websites. No ATT prompt required.
      · NSPrivacyTrackingDomains = empty — no tracking domains.
      · NSPrivacyCollectedDataTypes — the three categories we actually
        persist on Supabase, all linked to the user (scoped by user_id)
        and none used for tracking. Purposes are strictly
        "AppFunctionality".
      · NSPrivacyAccessedAPITypes — the Required-Reason APIs Flutter
        and our plugins transitively hit: UserDefaults (shared_prefs)
        and FileTimestamp (cached_network_image disk cache).

    IMPORTANT: camera frames are processed on-device via MLKit pose
    detection and never stored / uploaded — therefore we do NOT
    declare `NSPrivacyCollectedDataTypePhotosOrVideos`. The camera
    permission itself is still rationalised via Info.plist's
    `NSCameraUsageDescription`.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Email address — Supabase auth identifier. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Health & Fitness — weight, height, activity level, macros. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeHealthFitness</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Supabase user_id — scopes all server-side rows. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- shared_preferences wraps NSUserDefaults. Reason CA92.1 —
             "read/write information that is only accessible to the
             app itself." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- cached_network_image writes timestamps inside the app's
             own Documents/Caches container. Reason 3B52.1 —
             "access the timestamps of files inside the app
             container." -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
