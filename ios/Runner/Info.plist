<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FormAI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>FormAI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Antrenman sırasında formunu analiz etmek için kamerana ihtiyacımız var.</string>
	<!-- NSMicrophoneUsageDescription removed: the camera session runs
	     enableAudio:false and nothing records audio — an unused
	     permission string invites Apple 5.1.1(b) minimal-data questions.
	     NSUserTrackingUsageDescription removed with the ATT call: the
	     privacy manifest declares NSPrivacyTracking=false. -->

	<!-- Phase 54 · custom-scheme handler. Catches every `formai://...`
	     URL dispatched by the share-sheet (referral invites, badge
	     celebration deep-links). Universal Links over https://formai.app
	     are configured separately via the Associated Domains entitlement
	     (.entitlements file) once the apple-app-site-association is
	     hosted at https://formai.app/.well-known/apple-app-site-association. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.formai.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>formai</string>
			</array>
		</dict>
	</array>
	<!-- Phase 55 · iOS 16.1+ Live Activities flag. Without this key the
	     `live_activities` plugin's `init` succeeds but `createActivity`
	     no-ops silently. Both Runner and FormAIWidget targets need it. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Phase 55 · allow updates while the app is in the background.
	     Required for `WorkoutLiveActivityService.updateWorkout` calls
	     fired from the workout-camera background isolate as exercises
	     transition. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
</dict>
</plist>
