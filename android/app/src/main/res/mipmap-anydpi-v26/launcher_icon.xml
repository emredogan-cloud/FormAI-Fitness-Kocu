<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Layers are generated by
  `bash tool/gen_app_icons.sh` — do not hand-edit the PNGs.

  NO <inset> ON THE FOREGROUND, ON PURPOSE.

  The previous version wrapped the foreground in `<inset android:inset="16%">`.
  That belonged to the old photographic icon, where the artwork filled the
  BACKGROUND edge-to-edge and the foreground was a transparent overlay —
  the inset was tuning an overlay, not a logo.

  The icon is now the F logomark, and the layers swapped roles: the
  background carries the colour field, the foreground carries the glyph.
  `gen_app_icons.sh` already sizes that glyph so its furthest opaque pixel
  sits 31.9 dp from centre, inside the 36 dp circular-mask radius with
  4.1 dp of margin. Re-applying a 16% inset on top of that would shrink it
  to ~21.7 dp and leave the F floating small in a dark field, which is the
  exact failure the old comment in pubspec.yaml warned about.

  flutter_launcher_icons does NOT overwrite this file, so the edit is safe
  across regenerations.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
