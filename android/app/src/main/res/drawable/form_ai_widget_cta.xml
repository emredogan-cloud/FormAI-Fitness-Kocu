<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 55B · "Başlat" CTA capsule. Same defensive trim as
  form_ai_widget_pill.xml: 999dp → 16dp on the corner radius. Single
  solid colour, no gradient, no path data — safe for RemoteViews
  inflation on every supported launcher.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#39FF14" />
    <corners android:radius="16dp" />
</shape>
