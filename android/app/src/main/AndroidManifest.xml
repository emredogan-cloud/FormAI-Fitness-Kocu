<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required for Image.network (Unsplash onboarding photos) and any
         remote asset/REST traffic in release builds. The debug manifest
         already declares this for the Flutter dev tools. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires runtime POST_NOTIFICATIONS permission for
         flutter_local_notifications to post the daily workout reminder;
         RECEIVE_BOOT_COMPLETED lets the plugin re-register scheduled
         reminders after a reboot so users don't silently lose them. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="FormAI"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Phase 54 · custom-scheme deep links. Catches every
                 `formai://...` URL the share-sheet dispatches (referral
                 invites, badge celebration deep-links). The router
                 listener in `DeepLinkService` decodes the path and
                 routes to the relevant screen.

                 BROWSABLE + DEFAULT make the activity eligible to
                 handle implicit VIEW intents from browsers and other
                 apps; without BROWSABLE the OS would silently fall
                 through to the system chooser instead of FormAI. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="formai"/>
            </intent-filter>
            <!-- Phase 54 · App Links over HTTPS. Disabled by default
                 (`autoVerify="false"`) until the assetlinks.json is
                 hosted on formai.app — flipping the flag turns these
                 links into verified App Links that bypass the system
                 chooser. Until then they still open FormAI but go
                 through the chooser on first use. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="formai.app"/>
            </intent-filter>
        </activity>
        <!-- Phase 55 · home-screen widget receiver. The provider class
             reads SharedPreferences keys written by the Flutter
             `home_widget` package and renders them via RemoteViews.
             `updatePeriodMillis = 0` in widget-info means the OS never
             wakes us on a schedule — refresh is push-driven by the
             app-side `WidgetSyncService.push(...)`. -->
        <receiver
            android:name=".widget.FormAIHomeWidgetProvider"
            android:exported="true"
            android:label="FormAI">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/form_ai_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ (R / API 30) package visibility: required so
             flutter_tts can discover and bind to any installed TTS engine
             (Google, Samsung, Xiaomi/MIUI, etc.). Without this, getLanguages
             returns empty and speak() fails with "not bound to TTS engine". -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
